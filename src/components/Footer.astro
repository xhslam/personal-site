---
---

<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand reveal-bounce" data-reveal-delay="0ms">
        <div class="footer-logo">
          <span class="footer-logo-dot"></span>
          PORTFOLIO
        </div>
        <p class="footer-mission">
          用工程思维构建产品，<br />用 Agent 放大认知。
        </p>
      </div>

      <div class="footer-col reveal-bounce" data-reveal-delay="100ms">
        <h4 class="footer-col-title">
          <span class="footer-status-dot"></span>
          CURRENTLY · 2026
        </h4>
        <ul class="footer-status-list">
          <li><span class="status-label">STUDYING</span> 考研备考</li>
          <li><span class="status-label">TRAINING</span> 健身</li>
          <li><span class="status-label">BUILDING</span> Auris & Knowcraft</li>
        </ul>
      </div>

      <div class="footer-col reveal-bounce" data-reveal-delay="200ms">
        <h4 class="footer-col-title">导航</h4>
        <ul class="footer-links">
          <li><a href="/#works">作品</a></li>
          <li><a href="/writing">文章</a></li>
          <li><a href="/#now">当下</a></li>
          <li><a href="/#contact">联系</a></li>
        </ul>
      </div>

      <div class="footer-col reveal-bounce" data-reveal-delay="300ms">
        <h4 class="footer-col-title">项目</h4>
        <ul class="footer-links">
          <li><a href="/#works">Auris</a></li>
          <li><a href="/#works">Knowcraft</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom reveal-bounce" data-reveal-delay="400ms">
      <span>© 2026 Portfolio. All rights reserved.</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding: 80px 0 40px;
    border-top: 1px solid var(--border-subtle);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.5fr 1.2fr 1fr 1fr;
    gap: 48px;
    margin-bottom: 64px;
  }

  .footer-logo {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.05em;
    margin-bottom: 16px;
  }

  .footer-logo-dot {
    width: 8px;
    height: 8px;
    background: var(--text-primary);
  }

  .footer-mission {
    font-size: 14px;
    color: var(--text-tertiary);
    line-height: 1.6;
  }

  .footer-col-title {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .footer-status-dot {
    width: 8px;
    height: 8px;
    background: var(--accent-green);
  }

  .footer-status-list,
  .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .footer-status-list li {
    font-size: 13px;
    color: var(--text-tertiary);
  }

  .status-label {
    font-size: 10px;
    color: var(--text-muted);
    letter-spacing: 0.08em;
    margin-right: 8px;
  }

  .footer-links a {
    font-size: 13px;
    color: var(--text-tertiary);
    transition: color 0.2s;
  }

  .footer-links a:hover {
    color: var(--text-primary);
  }

  .footer-bottom {
    padding-top: 32px;
    border-top: 1px solid var(--border-subtle);
    font-size: 12px;
    color: var(--text-muted);
  }

  @media (max-width: 768px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 32px;
    }
  }
</style>
