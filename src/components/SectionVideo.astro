---
interface Props {
  src: string;
  /** 遮罩深浅：light | medium | dark */
  overlay?: 'light' | 'medium' | 'dark';
}

const { src, overlay = 'medium' } = Astro.props;

const overlayClass = {
  light: 'overlay-light',
  medium: 'overlay-medium',
  dark: 'overlay-dark',
}[overlay];
---

<div class="section-video" data-section-video>
  <div class="section-video-fallback" aria-hidden="true"></div>
  <video
    class="section-video-el"
    autoplay
    muted
    loop
    playsinline
    preload="metadata"
  >
    <source src={src} type="video/mp4" />
  </video>
  <div class={`section-video-overlay ${overlayClass}`}></div>
</div>

<style>
  .section-video {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .section-video-fallback {
    position: absolute;
    inset: 0;
    z-index: 0;
    background: #000;
  }

  .section-video-el {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .section-video-el.is-hidden {
    display: none;
  }

  .section-video-overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
  }

  .overlay-light {
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.45) 0%,
      rgba(0, 0, 0, 0.6) 100%
    );
  }

  .overlay-medium {
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.55) 0%,
      rgba(0, 0, 0, 0.72) 50%,
      rgba(0, 0, 0, 0.85) 100%
    );
  }

  .overlay-dark {
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.65) 0%,
      rgba(0, 0, 0, 0.8) 50%,
      rgba(0, 0, 0, 0.92) 100%
    );
  }
</style>
