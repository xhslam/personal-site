---
const projects = [
  {
    name: 'Auris',
    tagline: '智能音频感知与交互平台',
    description: '从声音到洞察——Auris 让机器真正「听懂」环境与人声，将音频流转化为可行动的结构化信息。',
    status: '运营中',
    meta: 'Audio AI · 2025',
    href: '#',
  },
  {
    name: 'Knowcraft',
    tagline: '知识工匠 Agent',
    description: 'Knowcraft 是一个面向深度工作者的 AI Agent——帮你采集、整理、连接知识，把碎片信息编织成可复用的思维网络。',
    status: '运营中',
    meta: 'Agent · 2026',
    href: '#',
  },
];
---

<section class="section works" id="works">
  <div class="container">
    <div class="works-header">
      <div>
        <span class="section-tag reveal-bounce" data-reveal-delay="0ms">VENTURES · 作品</span>
        <h2 class="section-title reveal-bounce" data-reveal-delay="80ms">作品版图</h2>
        <p class="section-desc reveal-bounce" data-reveal-delay="160ms">
          不是简历清单——是正在构建、正在迭代、正在改变工作方式的产品与 Agent。
        </p>
      </div>
      <span class="works-count reveal-bounce" data-reveal-delay="240ms">{projects.length} 个</span>
    </div>

    <div class="bento-grid">
      {projects.map((project, i) => (
        <a href={project.href} class="bento-cell reveal-bounce bounce-hover" data-reveal-delay={`${320 + i * 120}ms`}>
          <div class="bento-top">
            <span class="bento-status">
              <span class="status-dot"></span>
              {project.status}
            </span>
            <span class="bento-meta">{project.meta}</span>
          </div>
          <h3 class="bento-name">{project.name}</h3>
          <p class="bento-tagline">{project.tagline}</p>
          <p class="bento-desc">{project.description}</p>
          <div class="bento-footer">
            <span>了解详情</span>
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
              <path d="M3 11L11 3M11 3H5M11 3V9" stroke="currentColor" stroke-width="1.2"/>
            </svg>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .works-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 64px;
  }

  .section-tag {
    display: inline-block;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
    border: 1px solid var(--border-default);
    padding: 6px 12px;
    margin-bottom: 24px;
  }

  .works-count {
    font-size: 13px;
    color: var(--text-tertiary);
    padding-top: 8px;
  }

  .bento-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border: 1px solid var(--border-subtle);
  }

  .bento-cell {
    display: flex;
    flex-direction: column;
    padding: 40px;
    border-right: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
    transition: background 0.2s;
    min-height: 320px;
  }

  .bento-cell:nth-child(2n) { border-right: none; }
  .bento-cell:nth-last-child(-n+2) { border-bottom: none; }

  .bento-cell:hover {
    background: var(--surface-hover);
  }

  .bento-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 32px;
  }

  .bento-status {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    color: var(--text-tertiary);
  }

  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent-green);
    flex-shrink: 0;
  }

  .bento-meta {
    font-size: 11px;
    color: var(--text-muted);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .bento-name {
    font-size: 32px;
    font-weight: 700;
    margin-bottom: 8px;
  }

  .bento-tagline {
    font-size: 14px;
    color: var(--text-secondary);
    margin-bottom: 16px;
  }

  .bento-desc {
    font-size: 14px;
    color: var(--text-tertiary);
    line-height: 1.6;
    flex: 1;
  }

  .bento-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 32px;
    font-size: 13px;
    color: var(--text-muted);
  }

  .bento-cell:hover .bento-footer {
    color: var(--text-primary);
  }

  @media (max-width: 768px) {
    .bento-grid { grid-template-columns: 1fr; }
    .bento-cell {
      border-right: none;
      border-bottom: 1px solid var(--border-subtle);
    }
    .bento-cell:last-child { border-bottom: none; }
  }
</style>
