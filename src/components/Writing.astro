---
import { getCollection } from 'astro:content';

const posts = (await getCollection('writing')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const previewPosts = posts.slice(0, 4);
const totalCount = posts.length;

const formatDate = (date: Date) =>
  date.toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' }).replace(/\//g, '-');

const pad = (n: number) => String(n).padStart(2, '0');
---

<section class="section writing" id="writing">
  <div class="container">
    <div class="writing-header">
      <div>
        <span class="writing-breadcrumb reveal-bounce" data-reveal-delay="0ms">WRITING · 文章</span>
        <h2 class="section-title reveal-bounce" data-reveal-delay="80ms">文章</h2>
        <p class="section-desc reveal-bounce" data-reveal-delay="160ms">
          笑来分享合集——关于 AI、学习、生产与思考的笔记沉淀。
        </p>
      </div>
      <div class="writing-controls reveal-bounce" data-reveal-delay="240ms">
        <a href="/writing" class="writing-count">{totalCount} 篇 →</a>
      </div>
    </div>

    <a href="/writing" class="series-banner reveal-bounce bounce-hover" data-reveal-delay="320ms">
      <span class="series-badge">SERIES</span>
      <span class="series-text">笑来分享合集 · 把文章串成有顺序的阅读线</span>
      <span class="series-arrow">→</span>
    </a>

    <div class="article-list">
      {previewPosts.map((post, i) => (
        <a href={`/writing/${post.id}`} class="article-item reveal-bounce bounce-hover" data-reveal-delay={`${400 + i * 60}ms`}>
          <span class="article-index">{pad(i + 1)}</span>
          <div class="article-body">
            <div class="article-top">
              <h3 class="article-title">{post.data.title}</h3>
              <span class="article-date">{formatDate(post.data.date)}</span>
            </div>
            {post.data.description && (
              <p class="article-excerpt">{post.data.description}</p>
            )}
            <div class="article-meta">
              {post.data.readTime && <span>{post.data.readTime} 分钟</span>}
              {post.data.tags?.slice(0, 3).map((tag) => (
                <span class="article-tag">#{tag}</span>
              ))}
            </div>
          </div>
          <span class="article-arrow" aria-hidden="true">↗</span>
        </a>
      ))}
    </div>

    <a href="/writing" class="writing-more text-link reveal-bounce" data-reveal-delay="640ms">
      全部文章 →
    </a>
  </div>
</section>

<style>
  .writing-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 40px;
  }

  .writing-breadcrumb {
    display: inline-block;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
    border-bottom: 1px solid var(--border-default);
    padding-bottom: 8px;
    margin-bottom: 24px;
  }

  .writing-controls {
    padding-top: 8px;
  }

  .writing-count {
    font-size: 13px;
    color: var(--text-tertiary);
    transition: color 0.2s;
  }

  .writing-count:hover {
    color: var(--text-primary);
  }

  .writing-more {
    display: inline-block;
    margin-top: 48px;
    font-size: 13px;
  }

  .series-banner {
    display: flex;
    align-items: center;
    gap: 16px;
    background: var(--bg-card);
    border-radius: 8px;
    padding: 16px 20px;
    margin-bottom: 48px;
    transition: background 0.2s;
  }

  .series-banner:hover {
    background: var(--bg-card-alt);
  }

  .series-badge {
    font-size: 10px;
    letter-spacing: 0.1em;
    color: var(--text-muted);
    border: 1px solid var(--border-default);
    padding: 4px 8px;
    flex-shrink: 0;
  }

  .series-text {
    flex: 1;
    font-size: 14px;
    color: var(--text-tertiary);
  }

  .series-arrow {
    color: var(--text-muted);
    font-size: 14px;
  }

  .article-list {
    border-top: 1px solid var(--border-subtle);
  }

  .article-item {
    display: grid;
    grid-template-columns: 48px 1fr 24px;
    gap: 24px;
    padding: 32px 0;
    border-bottom: 1px solid var(--border-subtle);
    align-items: start;
    transition: background 0.2s;
  }

  .article-item:hover {
    background: var(--surface-hover);
    margin: 0 -16px;
    padding-left: 16px;
    padding-right: 16px;
  }

  .article-index {
    font-size: 11px;
    color: var(--text-muted);
    padding-top: 6px;
  }

  .article-top {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 8px;
  }

  .article-title {
    font-size: clamp(20px, 3vw, 24px);
    font-weight: 700;
    line-height: 1.35;
  }

  .article-date {
    font-size: 12px;
    color: var(--text-muted);
    flex-shrink: 0;
    padding-top: 6px;
  }

  .article-excerpt {
    font-size: 14px;
    color: var(--text-tertiary);
    line-height: 1.6;
    margin-bottom: 12px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    font-size: 12px;
    color: var(--text-muted);
  }

  .article-tag {
    color: var(--text-muted);
  }

  .article-arrow {
    font-size: 14px;
    color: var(--text-muted);
    padding-top: 6px;
  }

  .article-item:hover .article-arrow {
    color: var(--text-primary);
  }

  @media (max-width: 768px) {
    .article-top {
      flex-direction: column;
      gap: 4px;
    }

    .article-date {
      padding-top: 0;
    }
  }
</style>
