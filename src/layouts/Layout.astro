---
import '../styles/global.css';
import WechatModal from '../components/WechatModal.astro';

interface Props {
  title?: string;
}

const { title = 'Portfolio · 个人网站' } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="独立开发者 · Auris · Knowcraft Agent" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@300;400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
    <WechatModal />
    <script src="../scripts/wechat-modal.ts"></script>
  </body>
</html>

<style is:global>
  html, body {
    min-height: 100%;
    overflow-x: hidden;
  }
</style>
