---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { PROJECTS } from '../../api/_lib/releases.js';

const projects = Object.entries(PROJECTS).map(([id, project]) => ({
  id,
  ...project,
  platforms: Object.entries(project.platforms),
}));
---

<Layout title="下载 · Portfolio">
  <Nav />
  <main class="downloads-page">
    <div class="container">
      <header class="downloads-header">
        <span class="downloads-eyebrow">DOWNLOADS</span>
        <h1>下载</h1>
        <p>选择你的系统，获取最新版本。</p>
      </header>

      <div class="download-list">
        {projects.map((project, index) => (
          <article class="download-card" id={project.id} data-project={project.id}>
            <div class="download-card-header">
              <div class="download-product">
                <span class="download-index">{String(index + 1).padStart(2, '0')}</span>
                <div>
                  <h2>{project.name}</h2>
                  <p>{project.description}</p>
                </div>
              </div>
              <span class="download-version" data-version>最新版本</span>
            </div>

            <div class="platform-grid">
              {project.platforms.map(([platformId, platform]) => (
                <a
                  class="platform-link"
                  href={`/api/download?project=${project.id}&platform=${platformId}`}
                  data-platform={platformId}
                  aria-label={`下载 ${project.name} ${platform.label} ${platform.detail}`}
                >
                  <span class="platform-name">
                    <strong>{platform.label}</strong>
                    <span>{platform.detail}</span>
                  </span>
                  <span class="platform-action">
                    <span class="file-size" data-file-meta></span>
                    <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
                      <path d="M9 3V13M9 13L4.5 8.5M9 13L13.5 8.5M3 15H15" stroke="currentColor" stroke-width="1.3"/>
                    </svg>
                  </span>
                </a>
              ))}
            </div>

            <div class="download-card-meta">
              <span data-release-date></span>
              <span class="download-status" data-status role="status" aria-live="polite"></span>
            </div>
          </article>
        ))}
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<script src="../scripts/downloads.ts"></script>
<script src="../scripts/reveal-fade.ts"></script>

<style>
  .downloads-page {
    padding: 160px 0 120px;
  }

  .downloads-header {
    margin-bottom: 64px;
  }

  .downloads-eyebrow {
    display: inline-block;
    margin-bottom: 24px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--border-default);
    color: var(--text-muted);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.12em;
  }

  .downloads-header h1 {
    margin-bottom: 16px;
    font-size: clamp(40px, 5vw, 56px);
    line-height: 1.2;
  }

  .downloads-header p {
    color: var(--text-tertiary);
    font-size: 16px;
  }

  .download-list {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .download-card {
    scroll-margin-top: 120px;
    padding: 40px;
    border: 1px solid var(--border-subtle);
    background: rgba(10, 10, 10, 0.88);
  }

  .download-card-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 32px;
  }

  .download-product {
    display: flex;
    align-items: flex-start;
    gap: 24px;
  }

  .download-index {
    padding-top: 7px;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 11px;
  }

  .download-product h2 {
    margin-bottom: 6px;
    font-size: 30px;
    line-height: 1.2;
  }

  .download-product p {
    color: var(--text-tertiary);
    font-size: 14px;
  }

  .download-version {
    flex-shrink: 0;
    padding: 5px 10px;
    border: 1px solid var(--border-default);
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: 11px;
  }

  .platform-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .platform-link {
    display: flex;
    min-height: 76px;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 16px 20px;
    border: 1px solid var(--border-subtle);
    background: var(--surface-glass);
    transition: border-color 0.2s, background 0.2s;
  }

  .platform-link:hover {
    border-color: var(--border-default);
    background: var(--surface-hover);
  }

  .platform-link:focus-visible {
    outline: 2px solid var(--text-primary);
    outline-offset: 3px;
  }

  .platform-name {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .platform-name strong {
    font-size: 14px;
    font-weight: 500;
  }

  .platform-name > span {
    color: var(--text-muted);
    font-size: 12px;
  }

  .platform-action {
    display: flex;
    align-items: center;
    gap: 16px;
    color: var(--text-secondary);
  }

  .platform-link:hover .platform-action {
    color: var(--text-primary);
  }

  .file-size {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 11px;
    white-space: nowrap;
  }

  .download-card-meta {
    display: flex;
    min-height: 20px;
    justify-content: space-between;
    gap: 24px;
    margin-top: 20px;
    color: var(--text-muted);
    font-size: 11px;
  }

  .download-status {
    text-align: right;
  }

  @media (max-width: 768px) {
    .downloads-page {
      padding: 128px 0 80px;
    }

    .downloads-header {
      margin-bottom: 40px;
    }

    .download-card {
      padding: 24px;
    }

    .download-card-header {
      flex-direction: column;
      gap: 16px;
      margin-bottom: 24px;
    }

    .download-product {
      gap: 16px;
    }

    .download-product h2 {
      font-size: 26px;
    }

    .platform-grid {
      grid-template-columns: 1fr;
    }

    .download-card-meta {
      flex-direction: column;
      gap: 4px;
    }

    .download-status {
      text-align: left;
    }
  }
</style>
